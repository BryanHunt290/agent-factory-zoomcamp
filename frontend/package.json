{
  "name": "agent-factory-dashboard",
  "private": true,
  "version": "0.0.0",
  "description": "Agent Factory Dashboard v1: observe, approve, reconcile. Local development only.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "contract:generate": "node scripts/generate-contract.mjs",
    "contract:check": "node scripts/generate-contract.mjs --check",
    "check": "npm run contract:check && npm run typecheck && npm test"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.13.0",
    "jsdom": "30.1.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
