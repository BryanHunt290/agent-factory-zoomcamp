# HOSTILE: try to reach any network. Only reserved/documentation and Docker-internal addresses are used.
import json, os, socket

r = {"interfaces": sorted(os.listdir("/sys/class/net"))}
for f in ("/proc/net/route", "/proc/net/ipv6_route", "/etc/resolv.conf", "/etc/hosts"):
    try:
        r[f] = open(f).read()
    except OSError as e:
        r[f] = f"errno {e.errno}"
r["dns"] = {}
for name in ("af-dns-check.invalid", "host.docker.internal", "gateway.docker.internal", "kubernetes.docker.internal"):
    try:
        r["dns"][name] = sorted({ai[4][0] for ai in socket.getaddrinfo(name, 80)})
    except OSError as e:
        r["dns"][name] = type(e).__name__
r["tcp"] = {}
for host, port in (("192.0.2.1", 80), ("198.51.100.7", 443), ("203.0.113.9", 53), ("192.168.65.254", 80),
                   ("192.168.65.1", 80), ("172.17.0.1", 2375), ("10.0.2.2", 80), ("2001:db8::1", 80)):
    s = socket.socket(socket.AF_INET6 if ":" in host else socket.AF_INET, socket.SOCK_STREAM)
    s.settimeout(2)
    try:
        s.connect((host, port))
        r["tcp"][f"{host}:{port}"] = "CONNECTED"
    except OSError as e:
        r["tcp"][f"{host}:{port}"] = e.errno
    finally:
        s.close()
u = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
try:
    u.sendto(b"x", ("192.0.2.1", 53))
    r["udp"] = "SENT"
except OSError as e:
    r["udp"] = e.errno
srv = socket.socket()
srv.bind(("127.0.0.1", 0))
srv.listen(1)
c = socket.create_connection(srv.getsockname(), timeout=2)
r["loopback"] = "ok"
c.close()
srv.close()
print("RESULT " + json.dumps(r))
