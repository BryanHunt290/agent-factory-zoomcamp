# Example database configuration for Agent Factory (docs/database.md).
#
# SAFE TO COMMIT: placeholders only. Real values live in git-ignored files under
# .local/, created by `py -3.12 scripts/dev_postgres.py secrets`. Never commit a
# real password, and never put one on a command line.
#
# Agent Factory reads exactly ONE of these two:
AGENT_FACTORY_DATABASE_URL_FILE=.local/database.url
# AGENT_FACTORY_DATABASE_URL=postgresql://agent_factory_app:CHANGE-ME@127.0.0.1:55432/agent_factory_dev

# Optional; the default is agent_factory.
AGENT_FACTORY_DATABASE_SCHEMA=agent_factory

# The PostgreSQL integration tests use a separate database, through separate
# variables, so a test run can never touch the development database:
AGENT_FACTORY_TEST_DATABASE_URL_FILE=.local/test-database.url

# Production (later): the URL file will be provided by a secret manager, mounted
# read-only; Agent Factory only ever reads AGENT_FACTORY_DATABASE_URL_FILE.
